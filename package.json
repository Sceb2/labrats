{
  "name": "ocr-organic-revision",
  "version": "1.9.1",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "test": "node tests/run.cjs && node --test tests/auth-unit.cjs tests/progress-unit.cjs tests/sync-history-unit.cjs tests/retention-unit.cjs tests/adaptive-unit.cjs tests/cohort-unit.cjs tests/mechanism-cards.cjs tests/subjects-unit.cjs tests/design-unit.cjs tests/flashcards-unit.cjs",
    "test:mechanism-preview": "npm run build:previews && node --test tests/mechanism-preview-browser.cjs",
    "build:mechanisms": "node scripts/build-mechanism-cards.cjs && node scripts/build-mechanism-preview.cjs",
    "build:auth": "node scripts/build-auth.cjs",
    "build": "node scripts/build-privacy.cjs && node scripts/build-subjects.cjs && node scripts/build-flashcards.cjs && npm run build:auth && node scripts/build-staff.cjs && node scripts/prepare-site-release.cjs",
    "build:previews": "npm run build && node scripts/build-previews.cjs",
    "test:auth": "node --test tests/auth-integration.cjs",
    "test:auth-browser": "node --test tests/auth-browser.cjs",
    "test:auth-local": "npm run build:previews && node scripts/test-local-auth.cjs",
    "accounts": "node scripts/student-accounts.cjs",
    "test:applied-expansion": "npm run build:previews && node tests/applied-expansion-browser.cjs",
    "test:equations": "npm run build:previews && node tests/equation-sheet-browser.cjs",
    "test:practice-preview": "node tests/practice-preview-browser.cjs",
    "test:staff-layout": "node --test tests/staff-layout-browser.cjs",
    "test:privacy": "npm run build:previews && node --test tests/privacy-browser.cjs",
    "test:loading": "npm run build && node --test tests/loading-browser.cjs",
    "test:settings": "node tests/settings-browser.cjs",
    "test:design": "npm run build:previews && node --test tests/design-browser.cjs",
    "test:flashcards": "npm run build:previews && node --test tests/flashcards-unit.cjs tests/flashcards-browser.cjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.108.2"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "playwright": "1.56.1"
  }
}
